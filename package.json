{
  "name": "central-gas-guara",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "android:sync": "npx cap sync android",
    "android:assemble:cliente:release": "cd android && gradlew.bat assembleClienteRelease",
    "android:assemble:cliente2:release": "cd android && gradlew.bat assembleCliente2Release",
    "android:assemble:entregador:release": "cd android && gradlew.bat assembleEntregadorRelease",
    "android:bundle:cliente:release": "cd android && gradlew.bat bundleClienteRelease",
    "android:bundle:cliente2:release": "cd android && gradlew.bat bundleCliente2Release",
    "android:bundle:entregador:release": "cd android && gradlew.bat bundleEntregadorRelease",
    "android:install:cliente": "cd android && gradlew.bat installClienteDebug",
    "android:install:cliente2": "cd android && gradlew.bat installCliente2Debug",
    "android:install:entregador": "cd android && gradlew.bat installEntregadorDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/local-notifications": "^8.0.2",
    "@capacitor/push-notifications": "^8.0.3",
    "@supabase/supabase-js": "^2.100.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "uuid": "^13.0.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
